# Server health check secrets.
# Real keys are auto-generated by the app when you save checks in /config/server-health.
# Example key format:
# SLA_SERVER_HEALTH_<CHECK_ID>_PASSWORD="your-password"
# SLA_SERVER_HEALTH_<CHECK_ID>_BEARER_TOKEN="your-token"

# SMTP settings for email alerts
# Required for alert delivery:
# SLA_ALERT_SMTP_HOST="smtp.example.com"
# SLA_ALERT_SMTP_PORT="587"
# SLA_ALERT_FROM="sla-monitor@example.com"
#
# Optional auth:
# SLA_ALERT_SMTP_USERNAME="smtp-user"
# SLA_ALERT_SMTP_PASSWORD="smtp-password"
#
# Optional behavior:
# SLA_ALERT_SMTP_USE_TLS="true"
# SLA_ALERT_SMTP_USE_SSL="false"
# SLA_ALERT_SUBJECT_PREFIX="[SLA Server Health]"
# SLA_ALERT_REMINDER_SECONDS="900"
#
# Release notification defaults:
# SLA_RELEASE_NOTIFICATION_SUBJECT_PREFIX="[Release Notification]"
# SLA_RELEASE_NOTIFICATION_TO_RECIPIENTS="ops@example.com, qa@example.com"
# SLA_RELEASE_NOTIFICATION_CC_RECIPIENTS="lead@example.com"
# SLA_RELEASE_NOTIFICATION_SIGNATURE_HTML="<div>Your saved release signature</div>"
#
# Backward-compatible legacy variable:
# SLA_RELEASE_NOTIFICATION_RECIPIENTS="ops@example.com, qa@example.com"

# Release tracker (filesystem path scanning)
# Optional:
# SLA_RELEASE_BASE_PATH="/path/to/releases"
# SLA_RELEASE_POLL_INTERVAL_SECONDS="180"
#
# Optional SSH backup defaults for non-prod pre-deployment copies:
# SLA_RELEASE_BACKUP_HOST="nonprod-app01.internal"
# SLA_RELEASE_BACKUP_PORT="22"
# SLA_RELEASE_BACKUP_USERNAME="deploy-user"
# SLA_RELEASE_BACKUP_PASSWORD="ssh-password"
# SLA_RELEASE_BACKUP_SOURCE_PATH="/opt/nonprod/current"
# SLA_RELEASE_BACKUP_DESTINATION_PATH="/opt/nonprod/backups"
